---
import BaseHead from '../components/BaseHead.astro';
import HomePageDefault from '../components/home/HomePageDefault.astro';
import LengLandingPage from '../components/home/LengLandingPage.astro';
import { SITE_TITLE, SITE_DESCRIPTION, USE_LENG_LANDING } from '../consts';

const pageTitle = USE_LENG_LANDING ? 'LENG' : SITE_TITLE;
const pageDescription = USE_LENG_LANDING
	? 'Wishlist LENG on Steam — an online co-op rhythm shooter from 4ozStudio.'
	: SITE_DESCRIPTION;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body class:list={[{ 'leng-landing': USE_LENG_LANDING }]}>
		{USE_LENG_LANDING ? <LengLandingPage /> : <HomePageDefault />}
	</body>
</html>
