---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ShortFormCarousel from '../../components/ShortFormCarousel.astro';
import { PAGE_DESCRIPTIONS } from '../../consts';
import { getCollection } from 'astro:content';

const tuneInVideos = (await getCollection('tuneIn')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const shortFormClips = (await getCollection('shortForm')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en-NZ">
	<head>
		<BaseHead title="Tune-In | 4ozStudio" description={PAGE_DESCRIPTIONS.tuneIn} />
		<style>
			main {
				width: 760px;
				display: flex;
				flex-direction: column;
				justify-content: center;
				overflow: visible;
			}

			.tune-in {
				margin-top: 2vh;
			}

			.section-title {
				font-size: 1.5rem;
				font-weight: 600;
				margin: 2rem 0 1rem;
			}

			.card-ul {
				margin-top: 1rem;
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 1px;
				list-style-type: none;
				margin-left: 0;
				margin-right: 0;
				padding: 0;
			}

			ul li {
				border: 1px solid black;
				position: relative;
				transition: ease-in-out 0.1s;
			}

			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}

			ul li img {
				margin-bottom: 0.5rem;
				width: 100%;
				border: 1px solid black;
			}

			ul li a {
				height: 100%;
			}

			.top {
				border-bottom: 1px solid black;
				padding: 8px;
			}

			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
				padding: 6px 2px;
				padding-top: 0;
				font-weight: 600;
			}

			.description {
				color: black;
				font-size: 16px;
				padding: 10px;
				padding-bottom: 40px;
			}

			.card-action {
				position: absolute;
				right: 0;
				bottom: 0;
				font-size: 14px;
				color: black;
				font-weight: 600;
				display: flex;
				align-items: center;
				padding: 0 10px;
			}

			ul li a:hover h2,
			ul li a:hover h4,
			ul li a:hover .card-action {
				text-decoration: underline;
			}

			ul li a:hover .title {
				text-decoration: none;
			}

			ul li:hover {
				transform: translateY(-1px);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tune-in">
				<section>
					<ShortFormCarousel clips={shortFormClips} />

					<h2 class="section-title">Music Videos</h2>
					<ul class="card-ul">
						{
							tuneInVideos.map((video) => (
								<li>
									<a
										href={video.data.videoUrl || `/tune-in/${video.id}/`}
										target={video.data.videoUrl ? '_blank' : '_self'}
										title="Watch Video"
									>
										<div class="top">
											<img
												width={720}
												height={360}
												src={video.data.heroImage}
												alt="Video Thumbnail"
											/>
											<h2 class="title">{video.data.title}</h2>
										</div>
										<div class="bottom">
											<p class="description">{video.data.description}</p>
										</div>
										<p class="card-action">
											Watch Video
											<svg
												xmlns="http://www.w3.org/2000/svg"
												height="20px"
												viewBox="0 -960 960 960"
												width="20px"
												fill="#000000"
												><path
													d="m576-288-51-51 105-105H192v-72h438L525-621l51-51 192 192-192 192Z"
												></path></svg
											>
										</p>
									</a>
								</li>
							))
						}
					</ul>
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>
